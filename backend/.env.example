# PostgreSQL (must have the pgvector extension available)
DATABASE_URL=postgresql+psycopg2://web_news:web_news@localhost:5432/web_news

# Redis (broker + result backend for Celery)
REDIS_URL=redis://localhost:6379/0

# The AI pipeline (summarize/classify/sentiment) runs entirely locally
# through Ollama — no API key, no rate limit. Run ./start-ollama.sh first
# (downloads a portable, no-root Ollama + pulls the model below).
# qwen2.5:14b-instruct was chosen for stronger Vietnamese output quality than
# the smaller 7b/3b variants; a full analysis takes ~a few minutes per
# article on CPU-only hardware at this size. Swap to qwen2.5:7b-instruct or
# qwen2.5:3b-instruct for meaningfully faster CPU inference at some quality
# cost — there's no free lunch here without a GPU.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct

# Sentence-transformers model used for embeddings (multilingual, supports
# Vietnamese) — always local/free, no API key needed.
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# How many hours back an article can still be considered for the "hot" ranking
HOTNESS_WINDOW_HOURS=72
