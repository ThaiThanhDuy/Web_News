# PostgreSQL 15+ with the pgvector extension. Schema is managed by Alembic:
# `python scripts/init_db.py` (start-dev.sh runs it for you).
DATABASE_URL=postgresql+psycopg2://web_news:web_news@localhost:5432/web_news

# Redis: rate-limit state only (Groq token budget, per-domain crawl spacing,
# robots.txt cache). The job pool itself lives in Postgres.
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------- AI
# groq   — cloud API, needs GROQ_API_KEY (default)
# ollama — local model through ./start-ollama.sh (OLLAMA_* below), no key
LLM_PROVIDER=groq
GROQ_API_KEY=

# Model per stage. Both on gpt-oss-20b: the two stages share that model's
# free-tier quota, so a backlog drains slower, but every item that passes the
# rule filter gets full data (classification + summary).
CLASSIFY_MODEL=openai/gpt-oss-20b
SUMMARIZE_MODEL=openai/gpt-oss-20b
# Optional per-topic summarize model, JSON: {"ai": "openai/gpt-oss-120b"}
SUMMARIZE_MODEL_BY_TOPIC=
LLM_REASONING_EFFORT=low
# Our own budget per model, enforced before calling Groq (free tier: 8K
# tokens/min, 200K/day — keep the cap a little under the real limit).
GROQ_TPM_LIMIT=8000
GROQ_DAILY_TOKEN_CAP=160000
# 0 = summarize everything; e.g. 40 = skip summaries for low-relevance items.
AI_MIN_RELEVANCE=0

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct

# ----------------------------------------------------- dedupe / clustering
# Embeddings power same-story clustering across sources; they need ~0.5-1GB
# RAM. On a small VPS set false — SHA-256 and SimHash dedupe still run.
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
CLUSTER_DISTANCE_THRESHOLD=0.25
# Comma-separated, case-insensitive; items matching are dropped before AI.
BLOCKED_KEYWORDS=

# ------------------------------------------------------------- crawling
# YouTube's robots.txt forbids the channel RSS feeds, so YouTube sources use
# the YouTube Data API v3 (1 quota unit per fetch). Create a key in Google
# Cloud console → APIs & Services → YouTube Data API v3.
YOUTUBE_API_KEY=
CRAWL_DOMAIN_INTERVAL_SECONDS=2
RAW_DATA_DIR=data/raw
RAW_RETENTION_DAYS=7

# ------------------------------------------------------------ job pool
# queue:threads served by this worker process (python -m app.worker).
WORKER_QUEUES=fetch:2,parse:1,filter:1,ai_fast:1,ai_deep:1,deliver:1,maintenance:1

# ------------------------------------------------------------ web push
# Generate with: python scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A real contact for push services: mailto:you@yourdomain or https://yourdomain
VAPID_SUBJECT=
PUSH_MIN_RELEVANCE=60
PUSH_MAX_PER_HOUR=4

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
ARTICLE_RETENTION_DAYS=14
